#!/usr/bin/env bash
# wt: one git worktree + tmux session per branch.
# Worktrees live next to the main clone as <repo>--<slug> (slug = branch, / -> -);
# each gets a tmux session (default name: branch). Sessions are found by their
# start dir, so renaming one (prefix+$) doesn't break wt.
# Settings: see "config" below; override them in $WT_CONFIG.
set -euo pipefail

# --- config (defaults; override in $WT_CONFIG, a bash file) ---
WT_ROOT=""          # dir for worktrees; empty: next to the main clone
WT_SEP="--"         # worktree dir = <repo><WT_SEP><slug>
WT_REMOTE="origin"  # remote to check out existing branches from
WT_GIT_UI=""        # command for an extra window in new sessions (e.g. lazygit); empty: none
WT_DEV_SCRIPT="dev" # package.json script started in a "dev" window; empty: never
WT_PORT_START=3000  # first port tried for the dev server (passed as $PORT)
# copied from the invoking worktree into new ones (if missing there). Not
# .devurl: wt writes that only for the worktree that owns the port
WT_COPY_FILES=(.env .env.local .env.development.local)
# symlinked to the main clone's copy (if it exists there), so all worktrees share it
WT_LINK_FILES=()
# optional hook, run in a new worktree before linking: wt_before_link <main> <dir>
WT_CONFIG="${WT_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/wt/config.sh}"
# shellcheck source=/dev/null
if [ -f "$WT_CONFIG" ]; then . "$WT_CONFIG"; fi

usage() {
  cat <<'EOF'
usage:
  wt [pick]                fzf branch picker (bare wt opens it in a git repo)
  wt [options] <branch>    open <branch> in its own worktree + tmux session
    -d                     don't switch/attach to the session
    -n <name>              name for a new session (default: branch)
    --from <ref>           base for a new branch (default: current branch)
    --no-dev               install deps, but don't start the dev server
  wt ls                    list worktrees, dirty state and tmux sessions
  wt rm [-f] <branch>      remove worktree + session (-f: skip safety checks)
  wt close                 confirm, then wt rm the worktree you're in
  wt doctor                show config and settings, check deps and tmux keys
  wt -h | --help           this help

examples:
  wt                             pick a branch, or type a new one
  wt feat/x                      open feat/x, creating it if needed
  wt --from origin/main feat/y   new branch feat/y from a fresh origin/main
  wt ls                          what's checked out where
  wt rm feat/x                   remove feat/x's worktree + session

config: $WT_CONFIG (default ~/.config/wt/config.sh)
details: README.md in tmux-kit (https://github.com/rokbar/tmux-kit)
EOF
}

die() { echo "wt: $*" >&2; exit 1; }

# keep errors readable before a tmux popup closes
pause() { read -rsn1 -p "wt failed (see above); press any key"; }

# tmux session names can't contain . or :
clean_name() {
  local n="${1#.}"
  printf '%s' "${n//[.:]/_}"
}

# Folder-based name, same as zsh `t`.
session_name() { clean_name "$(basename "$1")"; }

# Name of the session started in <dir>, if any.
session_for() {
  tmux list-sessions -F '#{session_path}'$'\t''#{session_name}' 2>/dev/null |
    awk -F'\t' -v d="$1" '$1==d{print $2; exit}' || true
}

load_repo() {
  git rev-parse --git-dir >/dev/null 2>&1 || die "not in a git repo"
  here="$(git rev-parse --show-toplevel)"
  main="$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")"
  repo="$(basename "$main")"
  root="${WT_ROOT:-$(dirname "$main")}"
  root="${root/#\~/$HOME}"
}

wt_dir() { printf '%s/%s%s%s' "$root" "$repo" "$WT_SEP" "${1//\//-}"; }

current_branch() { git -C "$here" symbolic-ref --quiet --short HEAD || echo HEAD; }

# <remote>/<default branch>, e.g. origin/main
remote_default() {
  git -C "$main" symbolic-ref --quiet --short "refs/remotes/$WT_REMOTE/HEAD" 2>/dev/null || echo "$WT_REMOTE/main"
}

# Path of the worktree that has <branch> checked out, if any.
checked_out_at() {
  git -C "$main" worktree list --porcelain |
    awk -v ref="refs/heads/$1" '/^worktree /{p=substr($0,10)} $0=="branch " ref {print p; exit}'
}

create() {
  local branch="$1" dir="$2" base="$3"
  if [ -z "$base" ] && git -C "$main" show-ref --verify --quiet "refs/heads/$branch"; then
    git -C "$main" worktree add "$dir" "$branch"
  elif [ -z "$base" ] && git -C "$main" remote get-url "$WT_REMOTE" >/dev/null 2>&1 &&
    git -C "$main" fetch --quiet "$WT_REMOTE" "$branch" 2>/dev/null &&
    git -C "$main" show-ref --verify --quiet "refs/remotes/$WT_REMOTE/$branch"; then
    git -C "$main" worktree add --track -b "$branch" "$dir" "$WT_REMOTE/$branch"
  else
    [ -n "$base" ] || base="$(current_branch)"
    [ "$base" = HEAD ] && base="$(git -C "$here" rev-parse --short HEAD)"
    if [[ "$base" == "$WT_REMOTE/"* ]]; then
      git -C "$main" fetch --quiet "$WT_REMOTE" "${base#"$WT_REMOTE/"}" ||
        echo "wt: fetch failed; using local $base"
    fi
    echo "wt: new branch $branch from $base"
    git -C "$main" worktree add --no-track -b "$branch" "$dir" "$base"
  fi
}

# Copy per-worktree files from the invoking worktree; link shared ones to the main clone.
bootstrap() {
  local dir="$1" f up target copied="" linked=""
  for f in ${WT_COPY_FILES[@]+"${WT_COPY_FILES[@]}"}; do
    if [ -f "$here/$f" ] && [ ! -e "$dir/$f" ]; then cp "$here/$f" "$dir/$f"; copied+=", $f"; fi
  done
  if [ -n "$copied" ]; then echo "wt: copied ${copied#, }"; fi
  if declare -F wt_before_link >/dev/null; then wt_before_link "$main" "$dir"; fi
  for f in ${WT_LINK_FILES[@]+"${WT_LINK_FILES[@]}"}; do
    if [ -e "$main/$f" ] && [ ! -e "$dir/$f" ] && [ ! -L "$dir/$f" ]; then
      if [ "$root" = "$(dirname "$main")" ]; then
        # sibling: relative link, so it also resolves inside a devcontainer
        # one ../ per dir level in <f>, plus one out of the worktree
        up="$(printf '%s' "$f" | sed 's|[^/]*/|../|g; s|[^/]*$||')../"
        target="$up$repo/$f"
      else
        target="$main/$f"
      fi
      mkdir -p "$(dirname "$dir/$f")"
      ln -s "$target" "$dir/$f"
      linked+=", $f"
    fi
  done
  if [ -n "$linked" ]; then echo "wt: linked ${linked#, }"; fi
}

# pnpm/bun/yarn/npm, from the lockfile; empty if not a JS project.
pkg_manager() {
  if [ -f "$1/pnpm-lock.yaml" ]; then echo pnpm
  elif [ -f "$1/bun.lock" ] || [ -f "$1/bun.lockb" ]; then echo bun
  elif [ -f "$1/yarn.lock" ]; then echo yarn
  elif [ -f "$1/package-lock.json" ]; then echo npm
  fi
}

has_dev_script() {
  [ -n "$WT_DEV_SCRIPT" ] && [ -f "$1/package.json" ] &&
    grep -q "\"$WT_DEV_SCRIPT\"[[:space:]]*:" "$1/package.json"
}

# First port from $WT_PORT_START that nothing listens on and no other worktree
# of this repo has claimed in its .devurl (its server may just not be running now).
free_port() {
  local p="$WT_PORT_START" claimed
  claimed="$(cat "$main/.devurl" "$root/$repo$WT_SEP"*/.devurl 2>/dev/null |
    sed -n 's/.*:\([0-9][0-9]*\).*/\1/p' || true)"
  while grep -qx "$p" <<<"$claimed" || lsof -nP -iTCP:"$p" -sTCP:LISTEN >/dev/null 2>&1; do
    p=$((p + 1))
  done
  echo "$p"
}

# Hide <file> from git in every worktree (shared info/exclude, once), for repos
# that don't gitignore it: else it can get committed and wt rm sees it as work.
git_exclude() {
  local dir="$1" file="$2" ex
  ex="$(git -C "$dir" rev-parse --path-format=absolute --git-common-dir)/info/exclude"
  if grep -qxF "$file" "$ex" 2>/dev/null; then return; fi
  mkdir -p "${ex%/*}"
  # don't glue onto a last line that lacks its newline
  if [ -n "$(tail -c1 "$ex" 2>/dev/null)" ]; then echo >>"$ex"; fi
  echo "$file" >>"$ex"
}

open_session() {
  local dir="$1" fresh="$2" detach="$3" name="$4" ask="$5" branch="$6" dev="$7" def pm port win
  def="$(session_for "$dir")"
  if [ -n "$def" ]; then
    name="$def"
  else
    def="$(clean_name "$branch")"
    if tmux has-session -t "=$def" 2>/dev/null; then def="$(session_name "$dir")"; fi
    while :; do
      if [ "$ask" = 1 ] && [ -z "$name" ]; then read -r -p "session name [$def]: " name; fi
      name="$(clean_name "${name:-$def}")"
      if ! tmux has-session -t "=$name" 2>/dev/null; then break; fi
      [ "$ask" = 1 ] || die "tmux session $name already exists"
      echo "wt: tmux session $name already exists"
      name=""
    done
    # first window's index, for the install line (base-index: tmux 0, tmux-kit 1)
    win="$(tmux new-session -d -P -F '#{window_index}' -s "$name" -c "$dir")"
    if [ -n "$WT_GIT_UI" ] && command -v "${WT_GIT_UI%% *}" >/dev/null; then
      tmux new-window -d -t "=$name:" -n "${WT_GIT_UI%% *}" -c "$dir"
      tmux send-keys -t "=$name:${WT_GIT_UI%% *}" "$WT_GIT_UI" Enter
    fi
    pm="$(pkg_manager "$dir")"
    if [ "$fresh" = 1 ] && [ -n "$pm" ]; then
      if [ "$dev" = 1 ] && has_dev_script "$dir"; then
        # own window so the first one stays free; .devurl records which port
        # this worktree owns (for later wt runs and any tool that reads it)
        port="$(free_port)"
        echo "http://localhost:$port" >"$dir/.devurl"
        git_exclude "$dir" .devurl
        tmux new-window -d -t "=$name:" -n dev -c "$dir"
        tmux send-keys -t "=$name:dev" "$pm install && PORT=$port $pm run $WT_DEV_SCRIPT" Enter
        echo "wt: running $pm install (window dev)"
        echo "wt: dev server on http://localhost:$port (window dev)"
      else
        tmux send-keys -t "=$name:$win" "$pm install" Enter
        echo "wt: running $pm install (window $win)"
      fi
    fi
  fi
  echo "wt: $dir (tmux session $name)"
  if [ "$detach" = 1 ]; then return; fi
  if [ -n "${TMUX:-}" ]; then tmux switch-client -t "=$name"; else exec tmux attach -t "=$name"; fi
}

cmd_open() {
  local detach=0 base="" branch="" dir fresh=0 name="" ask=0 dev=1
  while [ $# -gt 0 ]; do
    case "$1" in
      -d) detach=1 ;;
      --no-dev) dev=0 ;;
      -n) name="${2:?-n needs a name}"; shift ;;
      --ask-name) ask=1 ;;
      --from) base="${2:?--from needs a ref}"; shift ;;
      -*) usage >&2; exit 1 ;;
      *) branch="$1" ;;
    esac
    shift
  done
  [ -n "$branch" ] || { usage >&2; exit 1; }
  git check-ref-format --branch "$branch" >/dev/null 2>&1 || die "invalid branch name: $branch"
  load_repo

  dir="$(checked_out_at "$branch")"
  if [ -n "$dir" ]; then
    [ -z "$base" ] || die "$branch already exists (checked out at $dir); --from ignored"
  else
    dir="$(wt_dir "$branch")"
    [ ! -e "$dir" ] || die "$dir exists but doesn't have $branch checked out"
    if [ -n "$base" ] && git -C "$main" show-ref --verify --quiet "refs/heads/$branch"; then
      die "$branch already exists; drop --from to check it out"
    fi
    if [ -n "$name" ] && tmux has-session -t "=$(clean_name "$name")" 2>/dev/null; then
      die "tmux session $(clean_name "$name") already exists"
    fi
    create "$branch" "$dir" "$base"
    bootstrap "$dir"
    fresh=1
  fi
  open_session "$dir" "$fresh" "$detach" "$name" "$ask" "$branch" "$dev"
}

in_work_tree() { git rev-parse --show-toplevel >/dev/null 2>&1; }

# bare wt opens the picker, but only where it can run; elsewhere it's help
can_pick() { in_work_tree && command -v fzf >/dev/null; }

# Picker rows, local branches then $WT_REMOTE-only ones, newest first:
# <● if checked out in a worktree> TAB <branch> TAB <[session] if it has one> TAB <ref>.
# One pass over worktrees and sessions (a lookup per branch is slow on big
# remotes), matched like checked_out_at and session_for: first session per dir.
pick_rows() {
  {
    git -C "$main" worktree list --porcelain |
      awk '/^worktree /{path=substr($0,10)} /^branch refs\/heads\//{print "worktree\t" substr($0,19) "\t" path}'
    tmux list-sessions -F 'session'$'\t''#{session_path}'$'\t''#{session_name}' 2>/dev/null || true
    git -C "$main" for-each-ref --sort=-committerdate --format='branch%09%(refname:short)%09%(refname)' refs/heads
    git -C "$main" for-each-ref --sort=-committerdate --format='branch%09%(refname:lstrip=3)%09%(refname)' "refs/remotes/$WT_REMOTE"
  } | awk -F'\t' -v OFS='\t' '
    $1 == "worktree" { wt[$2] = $3; next }
    $1 == "session" { if (!($2 in ses)) ses[$2] = $3; next }
    $2 == "HEAD" || seen[$2]++ { next }
    { dir = wt[$2]; print (dir != "" ? "●" : " "), $2, (dir in ses ? "[" ses[dir] "]" : ""), $3 }'
}

cmd_pick() {
  load_repo
  command -v fzf >/dev/null || die "fzf not installed"
  local out branch from="" remote header
  remote="$(remote_default)"
  header="$(printf '%s\n' "enter: open (creates <query> if no match)" \
    "alt-enter: new branch from $(current_branch)" "alt-o: new branch from $remote")"
  # markers are display-only: fzf shows fields 1-3 but searches and prints only
  # the branch; chunk tiebreak ranks equal scores by branch length (length would
  # count the markers too)
  out="$(
    pick_rows |
      fzf --prompt='branch> ' --header="$header" --delimiter='\t' --with-nth=..3 --nth=2 \
        --accept-nth=2 --tiebreak=chunk --tabstop=2 --preview='git log --oneline -15 {4} --' \
        --bind 'enter:accept-or-print-query,alt-enter:print-query,alt-o:become(echo :remote {q})'
  )" || {
    # 2: fzf failed, e.g. too old for these options (--accept-nth is 0.60+); else Esc
    [ $? = 2 ] || exit 0
    pause; exit 1
  }
  # alt-o prints ":remote <query>"
  case "$out" in ":remote "*) from="$remote"; out="${out#:remote }" ;; esac
  branch="$out"
  [ -n "$branch" ] || exit 0
  # separate process so set -e still applies; pause so errors stay visible in a popup
  "$0" --ask-name ${from:+--from "$from"} "$branch" || { pause; exit 1; }
}

cmd_close() {
  local top ans
  top="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "wt: not in a git repo"; pause; exit 1; }
  load_repo
  if [ "$top" = "$main" ]; then echo "wt: $top is the main clone, not a worktree"; pause; exit 1; fi
  read -r -p "remove worktree $(basename "$top")? [y/N] " ans
  case "$ans" in y | Y) ;; *) exit 0 ;; esac
  "$0" rm "$top" || { pause; exit 1; }
}

cmd_ls() {
  load_repo
  local d b flags s
  git -C "$main" worktree list --porcelain | sed -n 's/^worktree //p' | while IFS= read -r d; do
    if [ ! -d "$d" ]; then printf '%s  (missing; git worktree prune)\n' "$d"; continue; fi
    b="$(git -C "$d" symbolic-ref --quiet --short HEAD || echo '(detached)')"
    flags=""
    if [ -n "$(git -C "$d" status --porcelain)" ]; then flags+="  dirty"; fi
    s="$(session_for "$d")"
    if [ -n "$s" ]; then flags+="  [tmux: $s]"; fi
    printf '%s  %s%s\n' "$d" "$b" "$flags"
  done
}

cmd_rm() {
  local force=0 arg="" dir b name out f problems=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -f) force=1 ;;
      -*) usage >&2; exit 1 ;;
      *) arg="$1" ;;
    esac
    shift
  done
  [ -n "$arg" ] || { usage >&2; exit 1; }
  load_repo

  case "$arg" in
    /* | .*) dir="$(git -C "$arg" rev-parse --show-toplevel 2>/dev/null)" || die "not a git dir: $arg" ;;
    *)
      dir="$(checked_out_at "$arg")"
      [ -n "$dir" ] || dir="$(wt_dir "${arg#"$repo$WT_SEP"}")"
      ;;
  esac
  git -C "$main" worktree list --porcelain | grep -qxF "worktree $dir" || die "not a worktree: $dir"
  [ "$dir" != "$main" ] || die "refusing to remove the main clone"
  b="$(git -C "$dir" symbolic-ref --quiet --short HEAD || true)"
  name="$(session_for "$dir")"

  if [ "$force" = 0 ]; then
    # our own links show as untracked; they're removed below
    out="$(git -C "$dir" status --porcelain --untracked-files=all | while IFS= read -r l; do
      [ -L "$dir/${l#?? }" ] && [[ " ${WT_LINK_FILES[*]-} " == *" ${l#?? } "* ]] || echo "$l"
    done)"
    if [ -n "$out" ]; then problems+=$'\n'"uncommitted changes:"$'\n'"$out"; fi

    if [ -n "$b" ]; then
      out="$(git -C "$dir" log --oneline HEAD --not --exclude="$b" --branches --remotes)"
    else
      out="$(git -C "$dir" log --oneline HEAD --not --branches --remotes)"
    fi
    if [ -n "$out" ]; then problems+=$'\n'"commits on no other branch or remote:"$'\n'"$out"; fi

    for f in ${WT_LINK_FILES[@]+"${WT_LINK_FILES[@]}"}; do
      if [ -e "$dir/$f" ] && [ ! -L "$dir/$f" ]; then
        if [ -f "$dir/$f" ] && [ -f "$main/$f" ] && cmp -s "$dir/$f" "$main/$f"; then continue; fi
        problems+=$'\n'"$f is a real file/dir, not a link to the main clone (gitignored, would be lost): merge into $main/$f"
      fi
    done

    if [ -n "$problems" ]; then die "not removing $dir:$problems"$'\n'"(wt rm -f to force)"; fi
  fi

  if git -C "$main" worktree list --porcelain |
    awk -v w="worktree $dir" '$0==w{f=1;next} /^worktree /{f=0} f && /^locked/{found=1} END{exit !found}'; then
    die "$dir is locked (git worktree unlock it first)"
  fi

  for f in ${WT_LINK_FILES[@]+"${WT_LINK_FILES[@]}"}; do
    if [ -L "$dir/$f" ]; then rm "$dir/$f"; fi
  done
  # Instead of `git worktree remove`: node_modules can be 100k+ files, and
  # interrupting that slow, silent delete leaves a half-deleted, still-registered
  # worktree. mv is instant; prune unregisters it; the delete runs in background.
  local trash
  trash="$root/.wt-trash"
  mkdir -p "$trash"
  mv "$dir" "$trash/$$-$(basename "$dir")"
  git -C "$main" worktree prune
  nohup sh -c 'rm -rf "$1"/*' _ "$trash" >/dev/null 2>&1 &
  echo "wt: removed $dir${b:+; branch $b kept (git branch -d $b to delete)}"

  # last: if we're running inside this session, killing it ends us too
  if [ -n "$name" ]; then
    if [ -n "${TMUX:-}" ] && [ "$(tmux display-message -p '#S')" = "$name" ]; then
      tmux switch-client -t "=$(session_for "$main")" 2>/dev/null || tmux switch-client -l 2>/dev/null || true
    fi
    tmux kill-session -t "=$name"
  fi
}

# A setting the way config.sh would set it: WT_SEP=-- or WT_COPY_FILES=(.env .env.local)
show_setting() {
  local items=() x out=""
  if [[ "$(declare -p "$1")" != "declare -a"* ]]; then printf '  %s=%q\n' "$1" "${!1}"; return; fi
  # copy the array; bash 3.2 has no namerefs, and $1 is a variable name, safe to eval
  eval "items=(\${$1[@]+\"\${$1[@]}\"})"
  for x in ${items[@]+"${items[@]}"}; do printf -v x '%q' "$x"; out+=" $x"; done
  printf '  %s=(%s)\n' "$1" "${out# }"
}

# Whether prefix <key> runs wt <cmd> (as a word), from `tmux list-keys -T prefix` output <keys>.
show_key() {
  if grep -qE "^bind-key +(-r +)?-T prefix +$1 .*[^[:alnum:]_-]wt $2([^[:alnum:]_-]|\$)" <<<"$3"; then
    echo "  prefix $1: wt $2"
  else echo "  prefix $1: not bound to wt $2 (is tmux-kit's tmux.conf loaded?)"; fi
}

# tmux-kit's prefix W / X, in the server we're in (tmux talks to the one $TMUX names).
show_tmux_keys() {
  local keys
  if [ -z "${TMUX:-}" ]; then echo "tmux keys: not checked (not in tmux)"; return; fi
  # list-keys would start a new server if $TMUX's is gone; list-sessions doesn't
  if ! tmux list-sessions >/dev/null 2>&1; then
    echo "tmux keys: not checked (no tmux server at ${TMUX%%,*})"; return
  fi
  keys="$(tmux list-keys -T prefix 2>/dev/null || true)"
  echo "tmux keys:"
  show_key W pick "$keys"
  show_key X close "$keys"
}

# Which config file wt loaded, every setting and whether the hook is defined.
show_config() {
  local v
  if [ -f "$WT_CONFIG" ]; then echo "config: $WT_CONFIG (loaded)"
  else echo "config: $WT_CONFIG (not found; using defaults)"; fi
  # the settings in "config" above; not ${!WT_@}, the env has others (WT_SESSION)
  for v in WT_ROOT WT_SEP WT_REMOTE WT_GIT_UI WT_DEV_SCRIPT WT_PORT_START WT_COPY_FILES WT_LINK_FILES; do
    show_setting "$v"
  done
  if declare -F wt_before_link >/dev/null; then echo "  wt_before_link: defined"
  else echo "  wt_before_link: not defined"; fi
}

cmd_doctor() {
  local d p missing=""
  show_config
  if in_work_tree; then load_repo; echo "worktree root: $root"; fi

  echo "deps:"
  for d in tmux git fzf; do
    if p="$(command -v "$d")"; then echo "  $d: $p"; else echo "  $d: missing"; missing+=" $d"; fi
  done
  # only free_port uses it: without it, the dev server may get a busy port
  if p="$(command -v lsof)"; then echo "  lsof: $p"
  else echo "  lsof: missing (optional: wt can't see which dev ports are in use)"; fi
  if p="$(command -v wt)"; then echo "wt on PATH: $p"
  else echo "wt on PATH: not found (install.sh links it into ~/.local/bin; add that to PATH)"; fi

  show_tmux_keys
  echo "alt keys: not checked; alt-enter / alt-o need Option as Alt in your terminal"
  if [ -n "$missing" ]; then die "missing:$missing"; fi
}

case "${1:-}" in
  "") if can_pick; then cmd_pick; else usage; fi ;;
  -h | --help) usage ;;
  pick) shift; cmd_pick "$@" ;;
  close) cmd_close ;;
  doctor) cmd_doctor ;;
  ls) cmd_ls ;;
  rm) shift; cmd_rm "$@" ;;
  *) cmd_open "$@" ;;
esac
